{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(fdisk:*)",
      "Bash(gdisk:*)",
      "Bash(sgdisk:*)",
      "Bash(parted:*)",
      "Bash(wipefs:*)",
      "Bash(flashrom:*)",
      "Bash(grub-install:*)",
      "Bash(mkfs:*)",
      "Bash(mkfs.*)",
      "Bash(dd *of=/dev/*)",
      "Edit(/.nebulous/golden-snapshot.toml)",
      "Edit(/.nebulous/approvals.toml)",
      "Edit(/.nebulous/manifest.toml)",
      "Edit(//etc/**)"
    ],
    "ask": [
      "Bash(docker:*)",
      "Bash(podman:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "mcp__nebulous_ci__*"
    ],
    "allow": [
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(bash -n:*)",
      "Bash(make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(.claude/hooks/test-guards.sh)",
      "Bash(./scripts/lib/verify-deps.sh:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/step-lock.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-diff.sh\""
          }
        ]
      }
    ]
  }
}

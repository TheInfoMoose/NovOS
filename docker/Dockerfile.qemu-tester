# ==============================================================================
# NovOS Dual-Mode QEMU/KVM + noVNC Automated & Interactive ISO Tester
# ==============================================================================
FROM debian:sid-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    qemu-system-x86 \
    qemu-utils \
    ovmf \
    socat \
    openssh-client \
    sshpass \
    novnc \
    websockify \
    python3 \
    python3-yaml \
    python3-pil \
    xorriso \
    squashfs-tools \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 5900 6080 2222

WORKDIR /workspace
ENTRYPOINT ["python3", "/workspace/scripts/test-docker-qemu.py"]

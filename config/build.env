#!/usr/bin/env bash
# ==============================================================================
# NovOS Declarative Build Configuration
# ==============================================================================

# Distro Identity
export DISTRO_NAME="NovOS"
export DISTRO_ID="novos"
export DISTRO_VERSION="2026.10"
export DISTRO_CODENAME="nova"
export DEBIAN_SUITE="sid"
export DEBIAN_MIRROR="http://deb.debian.org/debian"

# System Locale, Timezone & Hostname
export TARGET_HOSTNAME="novos"
export TARGET_TIMEZONE="America/Chicago"
export TARGET_LOCALE="en_US.UTF-8"

# Default User Account
export DEFAULT_USER="devuser"
# Default passwords used for non-interactive build (change immediately via passwd or --prompt-passwords)
export DEFAULT_ROOT_PASS="novos"
export DEFAULT_USER_PASS="novos"
export PROMPT_PASSWORDS="true"

# Storage & Partitioning
export ESP_SIZE_MIB="6144"
export ESP_LABEL="NOVOS_EFI"
export ROOT_LABEL="NOVOS_ROOT"
export BTRFS_OPTS="noatime,compress=zstd:3,ssd_spread,commit=60,space_cache=v2"
export MOUNT_ROOT="/mnt/novos"

# Primary Build Target Configuration (Clean-Room Hybrid Live + Calamares Installer ISO)
export TARGET_MODE_DEFAULT="iso"
export ISO_PATH="./build/NovOS-sid-amd64.iso"

# Snapshot & Kernel Retention Policy (Prevents ESP & Btrfs Ballooning)
export MAX_SNAPSHOTS="5"
export MAX_HISTORICAL_KERNELS="2"

# Pre-installed Modular Profiles during chroot build
# Comma-separated list of: gaming,dev,llm,network (or "none" to defer to first boot via novos-setup)
export BUILD_PROFILES="none"
